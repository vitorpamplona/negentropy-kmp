#!/bin/bash

GREEN='\033[0;32m'
NO_COLOR='\033[0m'

echo "*********************************************************"
echo "Running git pre-push hook."
echo "*********************************************************"
echo ""
echo "Java Version: "
echo "$JAVA_HOME"
java -version
echo "Running test... "

# The Wasm tests need tooling that Gradle fetches from codeload.github.com, which some sandboxes
# (Claude Code on the web among them) block. Set it up on its own first; if that fails, run
# everything else and say loudly that the Wasm tests were skipped.
WASM_TESTS=":negentropy:wasmJsNodeTest"
if ! ./gradlew -q :kotlinWasmToolingSetup > /dev/null 2>&1; then
    echo "*********************************************************"
    echo 1>&2 "WARNING: could not set up the Wasm test tooling (is codeload.github.com blocked?)."
    echo 1>&2 "Skipping :negentropy:wasmJsNodeTest; run it where the network allows before merging."
    echo "*********************************************************"
    WASM_TESTS=""
fi

# CI's checks that run on Linux, plus the JS and Wasm tests in Node.js and the Apple metadata
# compile. The Apple tests need a Mac (CI's macOS job runs iosSimulatorArm64Test); the Windows
# tests need Windows (CI's windows job runs jvmTest there, mingwX64 only compiles here).
./gradlew spotlessCheck :negentropy:jvmTest :negentropy:testAndroidHostTest :negentropy:linuxX64Test :negentropy:jsNodeTest $WASM_TESTS :negentropy:compileAppleMainKotlinMetadata

status=$?

if [ "$status" = 0 ] ; then
    echo "All test passed."
    exit 0
else
    echo "*********************************************************"
    echo 1>&2 "Formatting or tests failed"
    printf "Run ${GREEN}./gradlew spotlessApply :negentropy:jvmTest :negentropy:testAndroidHostTest :negentropy:linuxX64Test${NO_COLOR}\n"
    printf "and ${GREEN}./gradlew :negentropy:jsNodeTest :negentropy:wasmJsNodeTest${NO_COLOR},\n"
    printf "and ${GREEN}./gradlew :negentropy:compileAppleMainKotlinMetadata${NO_COLOR}, and fix what fails before pushing...\n"
    echo "*********************************************************"
    exit 1
fi
